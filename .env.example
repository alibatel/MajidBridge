PORT=3000
# رمز ورود به مرورگر ابری (در hostim حتماً ست کن!)
PASSWORD=a-strong-password-here
VIEWPORT_W=1280
VIEWPORT_H=800
# کیفیت تصویر: low | medium | high
QUALITY=medium
# زوم پیش‌فرض صفحه (0.5 تا 3)
ZOOM=1
START_URL=https://example.com

# ── v2 ───────────────────────────────────────────────
# ضدشناسایی: اگر تیک امنیتی Cloudflare (مثلاً ChatGPT) کار نکرد، این را true کن
HEADFUL=false
# پوشه‌ی پروفایل ماندگار (کوکی/لاگین/تاریخچه/نشان‌ها)
PROFILE_DIR=/data/profile
# فقط برای تست خودکار: true یعنی دستور __eval فعال است (در محصول false!)
ALLOW_EVAL=false
# فقط برای تست بدون Chromium
MOCK_BROWSER=false
